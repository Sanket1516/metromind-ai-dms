FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    gcc \
    g++ \
    git \
    libffi-dev \
    libgl1 \
    libjpeg-dev \
    libmagic1 \
    libglib2.0-0 \
    libpq-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-hin \
    tesseract-ocr-mal \
    tesseract-ocr-tam \
    antiword \
    unrtf \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --upgrade "pip<24.1" setuptools wheel && \
    pip install -r requirements.txt

COPY . .

RUN chmod +x /app/docker/healthcheck.sh /app/docker/backend-entrypoint.sh

EXPOSE 8010 8011 8012 8013 8014 8015 8016 8017 8018 8019 8020 8021 8022 8023 8024 8025 8026 8027 8028

HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=5 \
    CMD /app/docker/healthcheck.sh

CMD ["/app/docker/backend-entrypoint.sh"]
